# School Management System - Environment Variables
# 
# Copy this file to .env and fill in the values.
# Never commit real secrets to version control.

# --- Django Settings ---
SECRET_KEY=django-insecure-development-key-do-not-use-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Database ---
# Use DATABASE_URL for dj_database_url, or individual vars:
DATABASE_URL=postgres://postgres:postgres@db:5432/school_management
POSTGRES_DB=school_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- CSRF ---
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# --- JWT ---
# These are managed by SimpleJWT; configure via SIMPLE_JWT in settings.py if needed
ACCESS_TOKEN_LIFETIME=30m
REFRESH_TOKEN_LIFETIME=7d

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@schoolmanagement.local

# --- Frontend URL ---
FRONTEND_URL=http://localhost:3000

# --- WhatsApp Business Cloud API (optional) ---
# Without these, the app continues working; notifications are logged as NOT_CONFIGURED.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v18.0