# Production Environment Template for Render
# Copy this to .env in the backend directory and update with your values

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=False
ALLOWED_HOSTS=school-management-backend.onrender.com,*.onrender.com,127.0.0.1

DB_NAME=school_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

CORS_ALLOWED_ORIGINS=https://school-management-frontend.onrender.com,http://localhost:3000

# --- Push notifications (optional) ---
# Notifications are always created and visible in-app even without these.
# Set these to additionally push announcements to phones (see
# apps/announcements/services.py and docs/NOTIFICATIONS.md).
# PUSH_PROVIDER=fcm
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_SERVICE_ACCOUNT_JSON=/path/to/service-account.json
