# Frontend Environment Configuration
#
# Option A (Recommended for local dev): Connect directly to local Django REST Framework
VITE_API_URL=http://127.0.0.1:8000/api

# Option B: Route through Vite development proxy (configured in vite.config.js)
# VITE_API_URL=/api

# Option C: Production backend (e.g. Render)
# VITE_API_URL=https://school-management-system-8lht.onrender.com/api
